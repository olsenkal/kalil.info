#!/usr/bin/env bash
# Strips EXIF/GPS from staged images under content/ before they are committed.
# Install once per clone:  git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r -d '' f; do
  files+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -z -- \
  'content/*.jpg' 'content/*.jpeg' 'content/*.png' 'content/*.heic' 'content/*.webp' \
  'content/*.JPG' 'content/*.JPEG' 'content/*.PNG' 'content/*.HEIC' 'content/*.WEBP')

[ "${#files[@]}" -eq 0 ] && exit 0

scripts/strip-exif.sh "${files[@]}"
git add -- "${files[@]}"
scripts/strip-exif.sh --check "${files[@]}" >/dev/null
